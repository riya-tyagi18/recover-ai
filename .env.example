# Recover AI — copy to .env and fill in real values. Never commit secrets.

# File-backed store (default). No database required to run locally.
DATABASE_URL=

# Python agent backend. Leave blank to use the built-in TypeScript agent.
# On production, set this to your deployed agent URL (e.g. https://agent.recover.ai).
AGENT_URL=http://127.0.0.1:8000

# LLM provider for the Python agent (mock | openai)
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Razorpay credentials (leave empty until you connect a live account)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Environment flag — set to "production" on your custom domain
RECOVER_AI_ENV=development
