# Recover AI — copy to .env and fill in real values. Never commit secrets.

# Hosted PostgreSQL database (Neon / Supabase).
# On Vercel serverless, sessions, rate limits, OTPs, and lockouts live in Postgres.
# Leave blank to use file-backed storage in local development.
DATABASE_URL=

# Demo mode flag: "true" to enable seeded demo accounts ("host" / "password" and "customer@recover.ai" / "password").
# In production mode ("false"), demo accounts and demo hints are completely disabled.
DEMO_MODE=true

# Email Two-Factor Authentication (OTP): "true" to require 6-digit verification code.
OTP_ENABLED=false

# Email provider credentials (Resend) for OTPs and password resets:
RESEND_API_KEY=
RESEND_FROM=Recover AI <onboarding@resend.dev>

# Optional SMTP configuration alternative:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Recover AI <noreply@recover.ai>

# Python agent backend. Leave blank to use the built-in TypeScript agent.
# On production, set this to your deployed agent URL (e.g. https://agent.recover.ai).
AGENT_URL=http://127.0.0.1:8000

# LLM provider for the Python agent (mock | openai)
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Razorpay credentials (leave empty until you connect a live account)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Environment flag — set to "production" on custom domain deployments
RECOVER_AI_ENV=development
