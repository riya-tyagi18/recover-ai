# Recover AI — copy to .env and fill in. Never commit real secrets.

# Phase 1: file-backed store at .data/store.json (no database required)
DATABASE_URL=

# Agent (Python). Not required for Phase 1 simulation generate/view.
AGENT_URL=http://127.0.0.1:8000
LLM_PROVIDER=mock
